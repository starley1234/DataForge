# B2B Lead Enrichment Engine (Enterprise Edition) — Production Settings

# База данных (SQLite по умолчанию, для продакшена укажите PostgreSQL)
DATABASE_URL=sqlite:///leads_b2b.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres_pass@localhost:5432/leads_b2b

# Интеграции и безопасность (опционально)
DADATA_API_KEY=your_dadata_api_key_here
API_SECRET_KEY=

# Сетевые таймауты
EGRUL_TIMEOUT=15.0
SCRAPER_TIMEOUT=8.0
SCRAPER_MAX_PAGES=6
HTTP_MAX_RETRIES=2

# Валидация DNS MX, Catch-All и почты
ENABLE_DNS_CACHE=true
DNS_CACHE_TTL_SECONDS=3600
CHECK_SMTP=false
SMTP_TIMEOUT=3.0
CHECK_CATCH_ALL=true

# Параметры веб-сервера и метрик
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
ENABLE_METRICS=true
BATCH_CONCURRENCY=4
BATCH_MAX_ITEMS=10000
