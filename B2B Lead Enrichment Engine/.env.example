# B2B Lead Enrichment Engine — Production Environment Variables

# База данных (SQLite по умолчанию, для продакшена укажите PostgreSQL)
DATABASE_URL=sqlite:///leads_b2b.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/leads_b2b

# Интеграции
DADATA_API_KEY=your_dadata_api_key_here

# Сетевые таймауты
EGRUL_TIMEOUT=15.0
SCRAPER_TIMEOUT=8.0
SCRAPER_MAX_PAGES=6

# Валидация DNS MX и почты
ENABLE_DNS_CACHE=true
DNS_CACHE_TTL_SECONDS=3600
CHECK_SMTP=false
SMTP_TIMEOUT=3.0

# Параметры веб-сервера
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
BATCH_CONCURRENCY=3
